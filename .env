PORT=3000
NODE_ENV=development

# PostgreSQL — Render provides this as the Internal Database URL
DATABASE_URL=postgres://user:password@host:5432/dbname

# Admin access — SHA-256 hash of your raw admin token
ADMIN_TOKEN_HASH=replace_with_sha256_of_your_token
ADMIN_IDENTIFIER=owner@inkstudio.com
ADMIN_EMAIL=owner@inkstudio.com

# Brevo
BREVO_API_KEY=xkeysib-your-key
BREVO_SENDER_EMAIL=bookings@inkstudio.com
BREVO_SENDER_NAME=Ink Studio

# Session
SESSION_SECRET=random_64_char_string
SESSION_TTL_MINUTES=30

# Payment expiry
PENDING_EXPIRY_HOURS=24
